{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/books/[id]/generate/route.ts": {
      "maxDuration": 300
    },
    "app/api/books/[id]/generate-page/route.ts": {
      "maxDuration": 300
    },
    "app/api/characters/[id]/generate/route.ts": {
      "maxDuration": 300
    },
    "app/api/characters/[id]/analyze/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/generate-books/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/generate-books",
      "schedule": "* * * * *"
    }
  ]
}
